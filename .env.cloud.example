# Normal operation keeps the management UI running. Temporarily use "enroll"
# for the first manual cloud-game login.
CLOUD_COMMAND=serve
CLOUD_ENABLE_NOVNC=1
CLOUD_WEB_HOST=0.0.0.0
CLOUD_WEB_PORT=8765
CLOUD_WEB_HOST_PORT=17880
CLOUD_NOVNC_PORT=15980
CLOUD_NOVNC_INTERNAL_PORT=15980
CLOUD_SCREEN=1280x720x24
CLOUD_SHM_SIZE=1gb
CLOUD_RESTART_POLICY=unless-stopped
CLOUD_LOG_MAX_SIZE=10m
CLOUD_LOG_MAX_FILES=5
CLOUD_DNS_PRIMARY=223.5.5.5
CLOUD_DNS_SECONDARY=8.8.8.8

# Cloud site and persistent-session behavior.
OK_WW_CLOUD_ADAPTER=docker.playwright_adapter:create_playwright_adapter
OK_WW_CLOUD_BROWSER_VISIBLE=true
OK_WW_CLOUD_CONFIG_DIR=/data/cloud/configs
OK_WW_CLOUD_HEADLESS=0
OK_WW_CLOUD_QUEUE=normal
OK_WW_CLOUD_LOGIN_TIMEOUT=900
OK_WW_CLOUD_QUEUE_TIMEOUT=7200

# Default full DailyTask bridge. Override only for diagnostics or custom tasks.
OK_WW_CLOUD_TASK_RUNNER=extensions.cloud.task_runner:create_daily_task_runner
OK_WW_WEB_DEFAULT_LANGUAGE=zh_CN

# Legacy single-schedule mode only. In serve mode the browser UI stores all
# schedules in /data/cloud/schedules.json and creates DailyTask at 04:00 by default.
RUN_AT=04:00
TZ=Asia/Shanghai
MISSED_WINDOW_MINUTES=120

# Optional email notification when an unattended saved login has expired.
OK_WW_SMTP_ENABLED=false
OK_WW_SMTP_HOST=
OK_WW_SMTP_PORT=587
OK_WW_SMTP_USERNAME=
OK_WW_SMTP_SENDER=
OK_WW_SMTP_RECIPIENT=
OK_WW_SMTP_USE_TLS=true
OK_WW_SMTP_USE_SSL=false
# Used only with compose.smtp.yaml. Store the password in this ignored host file;
# never put the password value itself in this environment file.
OK_WW_SMTP_PASSWORD_SOURCE=./secrets/smtp_password
